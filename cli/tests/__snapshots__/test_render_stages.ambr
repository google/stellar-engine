  }
  
  # use `gcloud organizations list`
  organization = {
    domain      = "example.com"
    id          = 123456789012
    customer_id = "C01234567"
  }
  
  # Per-environment folder for the provider and tfvars files that later
  # stages read. stellar derives it from the home on every render.
  outputs_location = "/home/operator/.stellar/envs/frm/fast-config"
  
  # Retention period (in days) for organization logging buckets (defaults to 365 days for compliance)
  logging_bucket_retention = 400
  
  # This variable is prepended to the names of all resources that are created.
  # Use something unique and no longer than 7 characters
  prefix = "frm"
  
  # Default log routing is set to "logging" (Cloud Logging buckets, retained for
  # logging_bucket_retention days; the default is 365)
  # To use long-term storage, change type to "storage" (GCS) or "bigquery"
  # To route to a SIEM, use "pubsub" (note: requires active subscriber to avoid log loss after 7 days)
  log_sinks = {
    audit-logs = {
      filter = "logName:\"/logs/cloudaudit.googleapis.com%2Factivity\" OR logName:\"/logs/cloudaudit.googleapis.com%2Fsystem_event\" OR protoPayload.metadata.@type=\"type.googleapis.com/google.cloud.audit.TransparencyLog\""
      type   = "storage"
    }
    vpc-sc = {
      filter = "protoPayload.metadata.@type=\"type.googleapis.com/google.cloud.audit.VpcServiceControlAuditMetadata\""
      type   = "storage"
    }
    workspace-audit-logs = {
      filter = "logName:\"/logs/cloudaudit.googleapis.com%2Fdata_access\" and protoPayload.serviceName:\"login.googleapis.com\""
      type   = "storage"
    }
    empty-audit-logs = {
      filter = ""
      type   = "storage"
    }
  }
  
  org_policies_config = {
    import_defaults = false
    constraints = {
      allowed_policy_member_domains = ["C0AAAAAAA"]
    }
  }
  
  fast_features = {
    envs = true
  }
  
  # Regime must be in all caps
  assured_workloads = {
    regime   = "FEDRAMP_MODERATE"
    location = "us-central1"
  }
  
  bootstrap_project = "example-bootstrap"
  
  alert_email = "alerts@example.com"
  
  # KMS protection level for CMEK keys. stellar derives it from the
  # regime: SOFTWARE for FEDRAMP_MODERATE, HSM for every other regime.
  # The variable has no default, so stellar always writes it. Set
  # kms_protection_level in answers.yaml to choose another level.
  kms_protection_level = "SOFTWARE"
  
  essential_contacts = "contacts@example.com"
  
  groups = {
    gcp-devops = "platform-devops"
  }
  
  '''
