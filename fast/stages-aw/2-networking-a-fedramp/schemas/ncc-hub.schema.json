{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NCC Hub Configuration",
  "description": "Schema for a Stellar Engine Stage 2 Network Connectivity Center (NCC) Hub YAML configuration file.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the NCC hub. Defaults to the YAML filename stem when omitted."
    },
    "project_id": {
      "type": "string",
      "description": "The project ID or $project_ids:<key> reference where the hub is created. Defaults to $project_ids:hub."
    },
    "description": {
      "type": "string",
      "description": "An optional description for the hub."
    },
    "export_psc": {
      "type": "boolean",
      "description": "Whether to export Private Service Connect routes across VPC spokes."
    },
    "policy_mode": {
      "type": "string",
      "enum": [
        "CUSTOM",
        "PRESET"
      ],
      "description": "The policy mode for the hub."
    },
    "preset_topology": {
      "type": "string",
      "enum": [
        "MESH",
        "STAR"
      ],
      "description": "The preset topology for the hub when policy_mode is PRESET."
    },
    "labels": {
      "$ref": "#/$defs/labels"
    },
    "groups": {
      "$ref": "#/$defs/groups"
    },
    "spokes": {
      "$ref": "#/$defs/spokes"
    }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "description": "Resource labels.",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,62}$": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{0,63}$"
        }
      }
    },
    "groups": {
      "type": "object",
      "description": "A map of NCC groups to manage on the hub.",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/group"
        },
        "center": {
          "$ref": "#/$defs/group"
        },
        "edge": {
          "$ref": "#/$defs/group"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "An optional description for the group."
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "auto_accept": {
          "type": "array",
          "description": "A list of project IDs or $project_ids:<key> references to auto-accept for group membership.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spokes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Spokes attached to this NCC hub.",
      "properties": {
        "vpcs": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "$ref": "#/$defs/vpc_spoke"
            }
          }
        },
        "tunnels": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "$ref": "#/$defs/hybrid_uri_spoke"
            }
          }
        },
        "vlan_attachments": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "$ref": "#/$defs/hybrid_uri_spoke"
            }
          }
        },
        "router_appliances": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "$ref": "#/$defs/router_appliance_spoke"
            }
          }
        }
      }
    },
    "vpc_spoke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vpc": {
          "type": "string",
          "description": "VPC self-link/ID or $vpcs:<key> / $networks:<key> reference. Defaults to the spoke key."
        },
        "name": {
          "type": "string",
          "description": "Optional override for the GCP spoke resource name."
        },
        "project_id": {
          "type": "string",
          "description": "Optional project ID or $project_ids:<key> where the spoke resource is created."
        },
        "group": {
          "type": "string",
          "description": "Optional group name, <hub>/<group>, $ncc_groups:<hub>/<group>, or full group ID."
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "exclude_export_ranges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_export_ranges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hybrid_uri_spoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uris"
      ],
      "properties": {
        "uris": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "List of HA VPN tunnel or Interconnect VLAN attachment URIs."
        },
        "name": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "description": "Region name or $locations:<key> reference. Defaults to regions.primary."
        },
        "project_id": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "site_to_site_data_transfer": {
          "type": "boolean"
        },
        "include_import_ranges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "router_appliance_spoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instances"
      ],
      "properties": {
        "instances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ip_address",
              "virtual_machine"
            ],
            "properties": {
              "ip_address": {
                "type": "string"
              },
              "virtual_machine": {
                "type": "string"
              }
            }
          }
        },
        "name": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "description": "Region name or $locations:<key> reference. Defaults to regions.primary."
        },
        "project_id": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "site_to_site_data_transfer": {
          "type": "boolean"
        },
        "include_import_ranges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
