main_project_id    = "xxxx-xxxx-main-0"
core_project_id    = "xxxx-xxxx-iac-core-0"
network_project_id = "xxxx-prod-net-host"

kms_keyring_name = "xxxx-xxxx-keyring"
kms_key_name     = "default"           # Must already exist

network_name    = "prod-spoke-0"         # Must already exist
subnetwork_name = "prod-tenant-1-subnet" # Must already exist

region = "us-east4"

# Optional custom image in a private Artifact Registry repository
# image = "us-east4-docker.pkg.dev/xxxx-xxxx-main-0/xxxx-repository/xxxx-image:latest"
# image_repository = {
#   location = "us-east4"
#   name     = "xxxx-repository"
# }

workstations = {
  "<WORKSTATION-NAME>" = {
    env = {
      CONFIG = "TEST"
      FOO    = "BAR"
    }
    users = ["user:<EMAIL-ADDRESS>"] # change/delete this
  }
}