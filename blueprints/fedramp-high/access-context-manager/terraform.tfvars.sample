organization_id = "123456789012"
region          = "us-east4"

main_project_id = "xxxx-xxxx-xxxx-main-0"

access_levels = [
  {
    name        = "accessPolicies/123456789012/accessLevels/corp_network"
    description = "Access only from the company network."
    conditions = [
      {
        ip_subnetworks = ["203.0.113.0/24"]
        members        = ["user:admin@example.com", "group:engineering@example.com"]
        negate         = false
        device_policy = {
          require_screen_lock = true
        }
        regions = ["US"]
      }
    ]
  }
]

service_perimeters = [
  {
    name        = "accessPolicies/123456789012/servicePerimeters/gcs_perimeter"
    description = "Perimeter for accessing GCP buckets."
    status = {
      restricted_services = ["storage.googleapis.com"]
      resources           = ["projects/123456789012"]
    }
  }
]
