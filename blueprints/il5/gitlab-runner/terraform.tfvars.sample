project_id         = "my-runner-project-0"
network_project_id = "my-net-host-0"
region             = "us-east4"
zone               = "us-east4-a"

network_name    = "my-vpc-0"
subnetwork_name = "my-subnet-0"

kms_key_id   = "projects/my-kms-0/locations/us-east4/keyRings/kr/cryptoKeys/vm"
golden_image = "projects/my-img-0/global/images/family/gitlab-runner-golden"

gitlab_url                  = "https://gitlab.example.com"
runner_token_secret_id      = "gitlab-runner-auth-token"
runner_token_secret_version = "latest"

instance_name      = "gitlab-runner-0"
service_account_id = "gitlab-runner-sa"
machine_type       = "n2d-standard-4"
executor           = "docker"
docker_image       = "us-east4-docker.pkg.dev/example-sec-0/containers/google-cloud-cli@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
boot_disk_size_gb  = 50
boot_disk_type     = "pd-balanced"

# Job images default to docker_image only; an empty service allowlist keeps
# CI services disabled. docker_cap_add re-adds capabilities after cap drop
# ALL for jobs that need them, such as CHOWN or SETUID.
allowed_docker_images   = null
allowed_docker_services = []
docker_cap_add          = []

# Repository-scoped roles/artifactregistry.reader grants for the private
# mirrors that docker_image and the allowlists pull from.
artifact_registry_repositories = [
  {
    project_id = "example-sec-0"
    location   = "us-east4"
    repository = "containers"
  },
]

# Optional Compute Engine graceful shutdown period (1 to 21600 seconds).
graceful_shutdown_secs = null

create_runner_token_secret = false
enable_boot_disk_snapshots = false
enable_iap_ssh             = false
enable_cloud_nat           = false
manage_kms_iam             = true

labels = {
  environment = "prod"
  workload    = "gitlab-runner"
}
