project_id         = "my-syslog-project"
network_project_id = "my-network-project"
region             = "us-east4"

network_name    = "my-shared-vpc"
subnetwork_name = "syslog-us-east4"

kms_key_id   = "projects/my-kms-0/locations/us-east4/keyRings/kr/cryptoKeys/vm"
golden_image = "projects/my-img-0/global/images/family/hardened-fluent-bit"

allowed_source_ranges = [
  "192.0.2.0/24",
  "198.51.100.0/24",
]

tls_secret_ids = {
  client_ca_cert = "syslog-client-ca-cert"
  server_cert    = "syslog-server-cert"
  server_key     = "syslog-server-key"
}

min_replicas = 2
max_replicas = 6
machine_type = "n2d-standard-2"

labels = {
  environment = "prod"
  workload    = "syslog-collector"
}
