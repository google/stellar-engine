main_project_id = "your-automation-project-id"
organization_id = "1234567890"

entitlements = {
  "breakglass-owner" = {
    parent_type = "organization"
    parent_id   = "1234567890"
    requesters  = ["group:gcp-organization-admins@example.com"]
    approvers   = ["group:gcp-security-admins@example.com"]
    role_bindings = [
      {
        role = "roles/resourcemanager.organizationAdmin"
      },
      {
        # Basic roles like roles/owner are not supported in PAM.
        role = "roles/compute.admin"
      }
    ]
    max_request_duration_hours = 1
    notification_recipients = {
      pending = ["security-alerts@example.com"]
    }
  }
}
